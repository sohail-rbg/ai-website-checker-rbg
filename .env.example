MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
MONGODB_DB=ai_website_checker
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
# Optional server-only alias. NEXT_PUBLIC_SITE_URL takes precedence.
SITE_URL=https://your-production-domain.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=you@example.com

ADMIN_TOKEN=change-this-admin-token
ADMIN_NOTIFY_EMAIL=admin@example.com

ENABLE_LIGHTHOUSE=true
LIGHTHOUSE_TIMEOUT_MS=45000
ENABLE_INTERNAL_LINK_CHECK=false

# Optional Search Console URL Inspection verification.
# Keep real credentials only in .env.local or production environment variables.
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:example.com
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_TIMEOUT_MS=30000
# Recommended for long-lived server use:
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

EXTERNAL_VERIFICATION_WEBHOOK_URL=
EXTERNAL_VERIFICATION_WEBHOOK_TOKEN=
